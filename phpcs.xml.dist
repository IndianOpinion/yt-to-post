<?xml version="1.0"?>
<ruleset name="yt-to-post">
    <description>PSR-12 for the plugin, its tests and examples.</description>
    <file>src</file>
    <file>tests</file>
    <file>examples</file>
    <file>yt-to-post.php</file>
    <file>uninstall.php</file>
    <file>autoload.php</file>
    <exclude-pattern>vendor/*</exclude-pattern>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12">
        <!-- Long prose strings and HTML in admin views read better unbroken. -->
        <exclude name="Generic.Files.LineLength"/>
    </rule>

    <!-- Entry files and the global wrappers declare and run by design. -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>yt-to-post.php</exclude-pattern>
        <exclude-pattern>uninstall.php</exclude-pattern>
        <exclude-pattern>autoload.php</exclude-pattern>
        <exclude-pattern>src/functions.php</exclude-pattern>
        <exclude-pattern>examples/*</exclude-pattern>
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
        <exclude-pattern>tests/phpstan-constants.php</exclude-pattern>
        <exclude-pattern>tests/stubs/*</exclude-pattern>
    </rule>

    <!-- The WordPress stand-ins mirror WordPress names. -->
    <rule ref="PSR1.Classes.ClassDeclaration">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.Classes.ValidClassName">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
        <exclude-pattern>src/Cli/Command.php</exclude-pattern>
    </rule>
</ruleset>
