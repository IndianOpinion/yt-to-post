{
    "name": "indianopinion/yt-to-post",
    "description": "WordPress plugin that turns one YouTube video into one draft: captions through the official Data API with the site's own OAuth, or a supplied transcript, then a structured article with the video embedded and the source credited.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "keywords": ["wordpress", "youtube", "transcript", "captions", "draft", "llm"],
    "homepage": "https://github.com/IndianOpinion/yt-to-post",
    "support": {
        "issues": "https://github.com/IndianOpinion/yt-to-post/issues",
        "source": "https://github.com/IndianOpinion/yt-to-post",
        "email": "hello@indianopinion.org"
    },
    "authors": [
        {
            "name": "Indian Opinion",
            "email": "hello@indianopinion.org",
            "homepage": "https://indianopinion.org"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/IndianOpinion/llm-json-php"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-dom": "*",
        "ext-libxml": "*",
        "indianopinion/llm-json-php": "^0.1"
    },
    "require-dev": {
        "php-stubs/wordpress-stubs": "^6.9",
        "php-stubs/wp-cli-stubs": "^2.12",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "suggest": {
        "ext-intl": "Unicode NFC normalisation for quote matching.",
        "ext-zlib": "Compresses stored transcripts.",
        "ext-sodium": "Encrypts the refresh token (WordPress ships a polyfill)."
    },
    "autoload": {
        "psr-4": {
            "IndianOpinion\\YtToPost\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IndianOpinion\\YtToPost\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "lint": "phpcs",
        "check": ["@lint", "@analyse", "@test"]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
